# Copier les variables nécessaires dans .env. Ne jamais publier les secrets.
DEBUG=True
SECRET_KEY=remplacer-par-une-cle-aleatoire-longue
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000
# Ne passer à True qu’après validation du catalogue, de la livraison et des pages légales.
SHOP_READY=False
PAYMENTS_ENABLED=False
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SHIPPING_RATE=
# Livraison standard offerte dès ce montant d’articles, hors livraison et avant code promotionnel.
FREE_SHIPPING_THRESHOLD_EUR=99.00

# E-mails de vérification (SMTP fourni par votre hébergeur ou service d’envoi)
EMAIL_DELIVERY_ENABLED=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=

# Alternative Gmail OAuth (optional, configured by scripts/connect_gmail.py)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
GMAIL_TOKEN_FILE=

# Après ./migrate-postgres : chemins privés, jamais les clés elles-mêmes.
# DATA_ENCRYPTION_KEY_FILE=/chemin/prive/data.key
# DATABASE_CONFIG_FILE=/chemin/prive/connection.json
# Hébergement PostgreSQL externe : TLS avec validation du certificat obligatoire.
# DATABASE_URL=postgresql://utilisateur:secret@serveur/base
# DATABASE_SSL_ROOT_CERT=/chemin/ca-du-fournisseur.pem

# Temporary local account testing; ignored when DEBUG=False.
LOCAL_SKIP_EMAIL_VERIFICATION=False

# Capture local only, no internet delivery; ignored when DEBUG=False
EMAIL_TEST_MODE=False

# Instructions de retour conformes aux CGV validées de la boutique.
RETURN_ADDRESS="La Caverne des Monts, 225 Rue des Monts Jura, 01410 Lélex"
RETURN_COSTS_TEXT="Consultez les conditions de vente pour les frais de retour. Pour un défaut ou une erreur de livraison, contactez la boutique avant l’envoi."

# Adresse de la gérante pour les notifications d’expédition (facultatif).
RETURN_NOTIFICATION_EMAIL=

# Informations publiques validées de l’entreprise. JSON : voir espace/legal.py et docs/AUDIT_LEGAL_2026-10-16.md.
SHOP_LEGAL={}
# Paramètres publics de facturation à confirmer avec le comptable (docs/FACTURATION.md).
# Aucun taux de TVA ni accord de numérotation n'est déduit automatiquement.
SHOP_INVOICING={}
# Ne confirmer ces points qu’après vérification réelle, avec la gérante / son conseil.
LEGAL_DOCUMENTS_APPROVED=False
LEGAL_PRIVACY_OPERATIONS_READY=False
LEGAL_PRODUCT_INFORMATION_READY=False
LEGAL_INVOICING_READY=False
LEGAL_ACCESSIBILITY_REVIEWED=False
