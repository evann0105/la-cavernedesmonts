#!/bin/sh
set -eu
PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$PROJECT_DIR"
if [ -x "$PROJECT_DIR/.venv/bin/python" ]; then
    exec "$PROJECT_DIR/.venv/bin/python" "$PROJECT_DIR/scripts/start_local.py" "$@"
fi
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$PROJECT_DIR/scripts/start_local.py" "$@"
fi
printf '%s\n' 'Python 3 est nécessaire. Installez Python 3.10 ou plus récent, puis relancez ./start.' >&2
exit 1
