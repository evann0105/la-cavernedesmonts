#!/bin/sh
set -eu
PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$PROJECT_DIR"
if [ -x "$PROJECT_DIR/.venv/bin/python" ]; then
    exec "$PROJECT_DIR/.venv/bin/python" "$PROJECT_DIR/scripts/start_local.py" "$@"
fi
for CAVERNE_PYTHON in python3.13 python3.14 python3.12 python3.11 python3; do
    if command -v "$CAVERNE_PYTHON" >/dev/null 2>&1; then
        exec "$CAVERNE_PYTHON" "$PROJECT_DIR/scripts/start_local.py" "$@"
    fi
done
printf '%s\n' 'Python 3.11 minimum est nécessaire. Python 3.13 est recommandé, puis relancez ./start.' >&2
exit 1
