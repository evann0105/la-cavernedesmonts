#!/bin/sh
set -eu
PAYMENT_TEST_PROJECT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$PAYMENT_TEST_PROJECT"
if [ -n "${CAVERNE_PAYMENT_TEST_PYTHON:-}" ]; then
    exec "$CAVERNE_PAYMENT_TEST_PYTHON" "$PAYMENT_TEST_PROJECT/scripts/start_payment_test.py" "$@"
fi
if [ -x "$PAYMENT_TEST_PROJECT/.venv/bin/python" ]; then
    exec "$PAYMENT_TEST_PROJECT/.venv/bin/python" "$PAYMENT_TEST_PROJECT/scripts/start_payment_test.py" "$@"
fi
for CAVERNE_PAYMENT_PYTHON in python3.13 python3.14 python3.12 python3.11 python3; do
    if command -v "$CAVERNE_PAYMENT_PYTHON" >/dev/null 2>&1; then
        exec "$CAVERNE_PAYMENT_PYTHON" "$PAYMENT_TEST_PROJECT/scripts/start_payment_test.py" "$@"
    fi
done
printf '%s\n' 'Python 3.11 minimum et les dépendances du site sont nécessaires. Python 3.13 est recommandé.' >&2
exit 1
